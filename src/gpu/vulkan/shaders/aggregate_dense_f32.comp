#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// tec: GROUP BY over one whole number key with a small range, no hash table: the group of a row is its key minus the smallest key
// arguments are scaled to whole numbers like aggregate_hash_reduce_fixed.comp, SUM is an exact 64 bit integer and MIN and MAX are 32 bit signed atomics
// the smallest row of each group stands in for the owner row so the CPU can read the key values back
//
// aggregate_dense_f64.comp is this file with double arguments, keep the two identical apart from the argument type.
//
// NOTE: binding layout/push-constant slot order MUST stay in sync with qe_aggregate

layout(local_size_x = 256) in;

#define FUNC_COUNT 0u
#define FUNC_SUM   1u
#define FUNC_AVG   2u
#define FUNC_MIN   3u
#define FUNC_MAX   4u
#define EMPTY      0xffffffffu
#define ROWS_PER_WORKGROUP 16384u
#define SHARED_WORDS 2048u

layout(std430, binding = 0) readonly buffer KeyBuf   { double keys[]; };
layout(std430, binding = 1) buffer InfoBuf           { uint info[]; };      // tec: per group, the complement of its smallest row then its row count
layout(std430, binding = 2) buffer SumBuf            { uint sum_words[]; }; // tec: per group and expr, the low then the high word
layout(std430, binding = 3) buffer MinBuf            { int min_out[]; };
layout(std430, binding = 4) buffer MaxBuf            { int max_out[]; };

layout(std430, binding = 5)  readonly buffer Arg0Buf { float arg0[]; };
layout(std430, binding = 6)  readonly buffer Arg1Buf { float arg1[]; };
layout(std430, binding = 7)  readonly buffer Arg2Buf { float arg2[]; };
layout(std430, binding = 8)  readonly buffer Arg3Buf { float arg3[]; };
layout(std430, binding = 9)  readonly buffer Arg4Buf { float arg4[]; };
layout(std430, binding = 10) readonly buffer Arg5Buf { float arg5[]; };
layout(std430, binding = 11) readonly buffer Arg6Buf { float arg6[]; };
layout(std430, binding = 12) readonly buffer Arg7Buf { float arg7[]; };

layout(push_constant) uniform PushConstants
{
  uint words[16];
} pc;

// tec: per group, one word for the smallest row, one for the count, then per expr a low and a high sum word
shared uint s_acc[SHARED_WORDS];
// tec: per group and expr, a min then a max, signed so the atomics order them as numbers
shared int s_mm[SHARED_WORDS];

const double POW10[7] = double[7](1.0lf, 10.0lf, 100.0lf, 1000.0lf, 10000.0lf, 100000.0lf, 1000000.0lf);

double
read_arg(uint e, uint row)
{
  switch (e)
  {
    case 0u: return arg0[row];
    case 1u: return arg1[row];
    case 2u: return arg2[row];
    case 3u: return arg3[row];
    case 4u: return arg4[row];
    case 5u: return arg5[row];
    case 6u: return arg6[row];
    case 7u: return arg7[row];
  }
  return 0.0lf;
}

void
main()
{
  uint row_count  = pc.words[0];
  uint num_exprs  = pc.words[2];
  uint func_codes = pc.words[4];
  uint scales     = pc.words[6];
  uint num_groups = pc.words[8];
  int  min_key    = int(pc.words[10]);

  uint thread = gl_LocalInvocationID.x;
  uint stride = 2u + num_exprs * 2u;
  uint mm_stride = num_exprs * 2u;

  for (uint i = thread; i < num_groups * stride; i += 256u)
  {
    uint field = i % stride;
    s_acc[i] = (field == 0u) ? EMPTY : 0u;
  }
  for (uint i = thread; i < num_groups * mm_stride; i += 256u)
  {
    s_mm[i] = ((i & 1u) == 0u) ? 0x7fffffff : int(0x80000000);
  }
  barrier();

  uint first = gl_WorkGroupID.x * ROWS_PER_WORKGROUP;
  uint last = min(first + ROWS_PER_WORKGROUP, row_count);
  for (uint row = first + thread; row < last; row += 256u)
  {
    int id = int(keys[row]) - min_key;
    if (id < 0 || uint(id) >= num_groups)
    {
      continue;
    }
    uint base = uint(id) * stride;
    uint mm_base = uint(id) * mm_stride;
    atomicMin(s_acc[base], row);
    atomicAdd(s_acc[base + 1u], 1u);

    for (uint e = 0u; e < num_exprs; e++)
    {
      uint func = (func_codes >> (e * 4u)) & 0xfu;
      if (func == FUNC_COUNT)
      {
        continue;
      }

      uint exponent = (scales >> (e * 4u)) & 0xfu;
      int q = int(floor(read_arg(e, row) * POW10[exponent] + 0.5lf));

      if (func == FUNC_SUM || func == FUNC_AVG)
      {
        uint entry = base + 2u + e * 2u;
        uint low = uint(q);
        uint before = atomicAdd(s_acc[entry], low);
        uint high_add = ((q < 0) ? 0xffffffffu : 0u) + ((before + low < before) ? 1u : 0u);
        if (high_add != 0u)
        {
          atomicAdd(s_acc[entry + 1u], high_add);
        }
      }
      else if (func == FUNC_MIN)
      {
        atomicMin(s_mm[mm_base + e * 2u], q);
      }
      else if (func == FUNC_MAX)
      {
        atomicMax(s_mm[mm_base + e * 2u + 1u], q);
      }
    }
  }
  barrier();

  // tec: fold this workgroup's accumulators into the global ones, skipping the groups it never saw
  for (uint g = thread; g < num_groups; g += 256u)
  {
    uint base = g * stride;
    uint count = s_acc[base + 1u];
    if (count == 0u)
    {
      continue;
    }

    // tec: the smallest row is kept as its complement so the buffer can start at zero and atomicMax picks the smallest
    atomicMax(info[g * 2u], ~s_acc[base]);
    atomicAdd(info[g * 2u + 1u], count);

    for (uint e = 0u; e < num_exprs; e++)
    {
      uint func = (func_codes >> (e * 4u)) & 0xfu;
      uint entry = base + 2u + e * 2u;
      uint mm_base = g * mm_stride;
      uint index = g * num_exprs + e;

      if (func == FUNC_SUM || func == FUNC_AVG)
      {
        uint low = s_acc[entry];
        uint high = s_acc[entry + 1u];
        uint before = atomicAdd(sum_words[index * 2u], low);
        uint high_add = high + ((before + low < before) ? 1u : 0u);
        if (high_add != 0u)
        {
          atomicAdd(sum_words[index * 2u + 1u], high_add);
        }
      }
      else if (func == FUNC_MIN)
      {
        atomicMin(min_out[index], s_mm[mm_base + e * 2u]);
      }
      else if (func == FUNC_MAX)
      {
        atomicMax(max_out[index], s_mm[mm_base + e * 2u + 1u]);
      }
    }
  }
}
