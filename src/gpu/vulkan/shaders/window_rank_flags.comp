#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// tec: first stage of GPU ROW_NUMBER/RANK/DENSE_RANK, marks per sorted position whether it starts a new partition and/or peer group
// dispatched with exactly real_count threads so padding rows never appear here
//
// NOTE: binding layout/push-constant slot order MUST stay in sync with qe_window_rank_gpu

layout(local_size_x = 256) in;

#define QE_SORT_MAX_KEYS 4

layout(std430, binding = 0) readonly buffer KeysBuf        { double keys[]; };
layout(std430, binding = 1) buffer PartitionFlagBuf        { uint partition_flag[]; };
layout(std430, binding = 2) buffer PeerFlagBuf              { uint peer_flag[]; };

layout(push_constant) uniform PushConstants
{
  uint words[16];
} pc;

void
main()
{
  uint n = pc.words[0];
  uint num_keys = pc.words[2];
  uint partition_key_count = pc.words[4];

  uint i = gl_GlobalInvocationID.x;
  if (i >= n)
  {
    return;
  }

  if (i == 0u)
  {
    partition_flag[i] = 1u;
    peer_flag[i] = 1u;
    return;
  }

  bool part_diff = false;
  for (uint k = 0u; k < partition_key_count; k++)
  {
    if (keys[i * QE_SORT_MAX_KEYS + k] != keys[(i - 1u) * QE_SORT_MAX_KEYS + k])
    {
      part_diff = true;
      break;
    }
  }

  bool order_diff = false;
  for (uint k = partition_key_count; k < num_keys; k++)
  {
    if (keys[i * QE_SORT_MAX_KEYS + k] != keys[(i - 1u) * QE_SORT_MAX_KEYS + k])
    {
      order_diff = true;
      break;
    }
  }

  partition_flag[i] = part_diff ? 1u : 0u;
  peer_flag[i] = (part_diff || order_diff) ? 1u : 0u;
}
