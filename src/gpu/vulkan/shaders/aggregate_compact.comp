#version 450

// tec: compacts the group by hash table on the GPU so only the occupied slots come back to the host
//   mode 0: one workgroup per block of 256 slots, scans the occupancy flags in shared memory and records the block total
//   mode 1: one workgroup scans the block totals, writes the group count to offsets[n] and total[0]
//   mode 2: adds each block's base to its entries, and writes the owner row and count of every occupied slot at its dense id
//
// NOTE: binding layout MUST stay in sync with qe_aggregate_impl

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer CountBuf    { uint slot_row_count[]; };
layout(std430, binding = 1) readonly buffer OwnerBuf    { uint owner_row_index[]; };
layout(std430, binding = 2) buffer OffsetsBuf           { uint offsets[]; };
layout(std430, binding = 3) buffer BlockSumBuf          { uint block_sums[]; };
layout(std430, binding = 4) buffer OutOwnerBuf          { uint out_owner[]; };
layout(std430, binding = 5) buffer OutCountBuf          { uint out_count[]; };
layout(std430, binding = 6) buffer TotalBuf             { uint total[]; };

layout(push_constant) uniform PushConstants
{
  uint words[16];
} pc;

shared uint scan[256];

void
scan_shared(uint thread)
{
  for (uint stride = 1u; stride < 256u; stride <<= 1u)
  {
    uint added = (thread >= stride) ? scan[thread - stride] : 0u;
    barrier();
    scan[thread] += added;
    barrier();
  }
}

void
main()
{
  uint n = pc.words[0];
  uint mode = pc.words[2]; // tec: each U64 kernel argument takes two push constant words
  uint thread = gl_LocalInvocationID.x;
  uint block_count = (n + 255u) / 256u;

  if (mode == 0u)
  {
    uint index = gl_GlobalInvocationID.x;
    uint value = (index < n && slot_row_count[index] != 0u) ? 1u : 0u;
    scan[thread] = value;
    barrier();
    scan_shared(thread);

    uint inclusive = scan[thread];
    if (index < n)
    {
      offsets[index] = inclusive - value;
    }
    if (thread == 255u)
    {
      block_sums[gl_WorkGroupID.x] = inclusive;
    }
  }
  else if (mode == 1u)
  {
    uint chunk = (block_count + 255u) / 256u;
    uint start = min(thread * chunk, block_count);
    uint end = min(start + chunk, block_count);

    uint sum = 0u;
    for (uint i = start; i < end; i++)
    {
      sum += block_sums[i];
    }

    scan[thread] = sum;
    barrier();
    scan_shared(thread);

    uint inclusive = scan[thread];
    uint running = inclusive - sum;
    for (uint i = start; i < end; i++)
    {
      uint block_total = block_sums[i];
      block_sums[i] = running;
      running += block_total;
    }

    if (thread == 255u)
    {
      offsets[n] = inclusive;
      total[0] = inclusive;
    }
  }
  else
  {
    uint index = gl_GlobalInvocationID.x;
    if (index < n)
    {
      uint id = offsets[index] + block_sums[index / 256u];
      offsets[index] = id;
      uint count = slot_row_count[index];
      if (count != 0u)
      {
        out_owner[id] = owner_row_index[index];
        out_count[id] = count;
      }
    }
  }
}
