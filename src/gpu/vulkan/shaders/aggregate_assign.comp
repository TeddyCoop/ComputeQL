#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// tec: pass 1/3 of the group-by pipeline. Each thread (one input row) hashes its 
// group key(s) and open-address linear-probes a fixed-size table of *row
// owners* (not encoded key values) via atomicCompSwap - claims an empty slot, or if already
// claimed, re-reads the owning row's actual key value(s) (from the same immutable input arrays -
// no synchronization needed beyond the CAS itself) to confirm same-group vs. a hash collision.
// This "compare by re-reading the owning row" trick is what lets one mechanism handle numeric
// AND string group keys (and composite/multi-column keys) without ever CAS'ing more than a
// 32-bit row index. No GROUP BY (num_group_cols==0) degenerates to a single bucket/slot, so
// every row trivially claims/matches slot 0 - same code path, no special case needed.
//
// NOTE: binding layout/push-constant slot order MUST stay in sync with qe_aggregate

layout(local_size_x = 1) in;

layout(std430, binding = 0) buffer OwnerBuf    { uint owner_row_index[]; };
layout(std430, binding = 1) buffer CountBuf    { uint slot_row_count[]; };
layout(std430, binding = 2) buffer RowSlotBuf  { uint row_slot_out[]; };
layout(std430, binding = 3) buffer OverflowBuf { uint overflow_count[]; };

layout(std430, binding = 4)  readonly buffer Col0DataBuf { uint col0_data[]; };
layout(std430, binding = 5)  readonly buffer Col0OffBuf  { uint col0_off[]; };
layout(std430, binding = 6)  readonly buffer Col1DataBuf { uint col1_data[]; };
layout(std430, binding = 7)  readonly buffer Col1OffBuf  { uint col1_off[]; };
layout(std430, binding = 8)  readonly buffer Col2DataBuf { uint col2_data[]; };
layout(std430, binding = 9)  readonly buffer Col2OffBuf  { uint col2_off[]; };
layout(std430, binding = 10) readonly buffer Col3DataBuf { uint col3_data[]; };
layout(std430, binding = 11) readonly buffer Col3OffBuf  { uint col3_off[]; };

layout(push_constant) uniform PushConstants
{
  uint words[16];
} pc;

#define EMPTY 0xffffffffu

uint
read_word(uint c, uint idx)
{
  switch (c)
  {
    case 0u: return col0_data[idx];
    case 1u: return col1_data[idx];
    case 2u: return col2_data[idx];
    case 3u: return col3_data[idx];
  }
  return 0u;
}

uint
read_off(uint c, uint idx)
{
  switch (c)
  {
    case 0u: return col0_off[idx];
    case 1u: return col1_off[idx];
    case 2u: return col2_off[idx];
    case 3u: return col3_off[idx];
  }
  return 0u;
}

uint
read_byte(uint c, uint byte_index)
{
  uint word = read_word(c, byte_index / 4u);
  uint shift = (byte_index % 4u) * 8u;
  return (word >> shift) & 0xffu;
}

uint
read_str_offset(uint c, uint row)
{
  return read_off(c, row * 2u); // tec: low word only - blobs assumed under 4GB, matches scan_filter.comp
}

double
read_numeric(uint c, uint row)
{
  uint lo = read_word(c, row * 2u + 0u);
  uint hi = read_word(c, row * 2u + 1u);
  return packDouble2x32(uvec2(lo, hi));
}

bool
keys_equal_one(uint c, bool is_str, uint row_a, uint row_b)
{
  if (is_str)
  {
    uint start_a = read_str_offset(c, row_a);
    uint end_a = read_str_offset(c, row_a + 1u);
    uint start_b = read_str_offset(c, row_b);
    uint end_b = read_str_offset(c, row_b + 1u);
    uint len_a = end_a - start_a;
    uint len_b = end_b - start_b;
    if (len_a != len_b) return false;

    for (uint i = 0u; i < len_a; i++)
    {
      if (read_byte(c, start_a + i) != read_byte(c, start_b + i)) return false;
    }
    return true;
  }

  return read_numeric(c, row_a) == read_numeric(c, row_b);
}

uint
hash_u32(uint x)
{
  x ^= x >> 16u; x *= 0x7feb352du;
  x ^= x >> 15u; x *= 0x846ca68bu;
  x ^= x >> 16u;
  return x;
}

uint
compute_key_hash(uint num_group_cols, uint string_mask, uint row)
{
  uint h = 2166136261u;
  for (uint c = 0u; c < num_group_cols; c++)
  {
    bool is_str = ((string_mask >> c) & 1u) != 0u;
    uint hh;

    if (is_str)
    {
      uint start = read_str_offset(c, row);
      uint end = read_str_offset(c, row + 1u);
      hh = 2166136261u;
      for (uint i = start; i < end; i++)
      {
        hh = (hh ^ read_byte(c, i)) * 16777619u;
      }
    }
    else
    {
      uvec2 bits = unpackDouble2x32(read_numeric(c, row));
      hh = hash_u32(bits.x ^ hash_u32(bits.y));
    }

    h = hash_u32(h ^ hh);
  }
  return h;
}

void
main()
{
  uint row_count       = pc.words[0];
  uint num_buckets     = pc.words[2];
  uint K               = pc.words[4];
  uint num_group_cols  = pc.words[6];
  uint string_mask     = pc.words[8];

  uint row = gl_GlobalInvocationID.x;
  if (row >= row_count) return;

  uint h = compute_key_hash(num_group_cols, string_mask, row);
  uint bucket = h % num_buckets;
  uint probe_start = bucket * K;

  uint claimed_slot = EMPTY;
  for (uint p = 0u; p < K; p++)
  {
    uint slot = probe_start + p;
    uint prev = atomicCompSwap(owner_row_index[slot], EMPTY, row);
    if (prev == EMPTY)
    {
      claimed_slot = slot;
      break;
    }

    bool same = true;
    for (uint c = 0u; c < num_group_cols; c++)
    {
      bool is_str = ((string_mask >> c) & 1u) != 0u;
      if (!keys_equal_one(c, is_str, row, prev)) { same = false; break; }
    }
    if (same)
    {
      claimed_slot = slot;
      break;
    }
  }

  if (claimed_slot == EMPTY)
  {
    atomicAdd(overflow_count[0], 1u);
    return;
  }

  row_slot_out[row] = claimed_slot;
  atomicAdd(slot_row_count[claimed_slot], 1u);
}
