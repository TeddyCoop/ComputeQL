#version 450

// tec: third stage of GPU ROW_NUMBER/RANK/DENSE_RANK, each value is a per-partition or per-peer-group offset lookup:
//   row_number  = sorted position - the position where my partition started, + 1
//   rank        = the position where my peer group started - my partition's start position, + 1
//   dense_rank  = my peer group's id - my partition's first peer group id, + 1
//
// NOTE: binding layout/push-constant slot order MUST stay in sync with qe_window_rank_gpu

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer PartitionIdBuf   { uint partition_id[]; };
layout(std430, binding = 1) readonly buffer PeerGroupIdBuf   { uint peer_group_id[]; };
layout(std430, binding = 2) readonly buffer PartitionStartPosBuf { uint partition_start_pos[]; };
layout(std430, binding = 3) readonly buffer PartitionBasePeerGroupBuf { uint partition_base_peer_group_id[]; };
layout(std430, binding = 4) readonly buffer PeerGroupStartPosBuf { uint peer_group_start_pos[]; };
layout(std430, binding = 5) buffer RowNumberBuf { uint row_number[]; };
layout(std430, binding = 6) buffer RankBuf      { uint rank_out[]; };
layout(std430, binding = 7) buffer DenseRankBuf { uint dense_rank[]; };

layout(push_constant) uniform PushConstants
{
  uint words[16];
} pc;

void
main()
{
  uint n = pc.words[0];
  uint i = gl_GlobalInvocationID.x;
  if (i >= n)
  {
    return;
  }

  uint pid = partition_id[i];
  uint gid = peer_group_id[i];

  row_number[i] = i - partition_start_pos[pid] + 1u;
  rank_out[i] = peer_group_start_pos[gid] - partition_start_pos[pid] + 1u;
  dense_rank[i] = gid - partition_base_peer_group_id[pid] + 1u;
}
