#version 450

// tec: scan_filter.comp on a 32 bit stack, with no doubles & no shaderFloat64.
// the host sends it only programs whose columns are 32 bits wide (qe_typed_program_from_bytecode in query_exec.c):
//   - a comparison opcode carries its domain in bits 8 and up: 0 compares as uint, 1 as int, 2 as float
//   - a PUSH_CONST operand indexes num_consts, one 32 bit word per constant, already converted to its comparison's domain
//   - no SIMILARITY() or EDIT_DISTANCE()
//
// NOTE: binding layout/opcode values MUST stay in sync with query_exec.h & scan_filter.comp

layout(local_size_x = 256) in;

#define OP_PUSH_TRUE     0
#define OP_LOAD_NUM_COL  1
#define OP_PUSH_CONST    2
#define OP_CMP_EQ        3
#define OP_CMP_NE        4
#define OP_CMP_LT        5
#define OP_CMP_GT        6
#define OP_CMP_LE        7
#define OP_CMP_GE        8
#define OP_AND           9
#define OP_OR            10
#define OP_STR_EQ        11
#define OP_STR_CONTAINS  12
#define OP_HALT          13
#define OP_PUSH_FALSE    14
#define OP_STR_NE        17
#define OP_STR_LT        18
#define OP_STR_GT        19
#define OP_STR_LE        20
#define OP_STR_GE        21

#define DOMAIN_SHIFT 8u
#define DOMAIN_U32   0u
#define DOMAIN_I32   1u
#define DOMAIN_F32   2u

#define COLTYPE_BOOL 6

#define MAX_STACK 8

layout(std430, binding = 0) readonly buffer BytecodeBuf   { uint bytecode[]; };
layout(std430, binding = 1) readonly buffer NumConstsBuf  { uint num_consts[]; };
layout(std430, binding = 2) readonly buffer StrConstsBuf  { uint str_consts[]; };
layout(std430, binding = 3) buffer OutIndicesBuf          { uint out_indices[]; };
layout(std430, binding = 4) buffer OutCountBuf            { uint out_count[]; };

// tec: one bit per zone map chunk, set when the zone map proves no row of the chunk can match
layout(std430, binding = 5) readonly buffer SkipBuf { uint skip_bits[]; };
layout(std430, binding = 6)  readonly buffer ColBuf6  { uint col_data6[]; };
layout(std430, binding = 7)  readonly buffer ColBuf7  { uint col_data7[]; };
layout(std430, binding = 8)  readonly buffer ColBuf8  { uint col_data8[]; };
layout(std430, binding = 9)  readonly buffer ColBuf9  { uint col_data9[]; };
layout(std430, binding = 10) readonly buffer ColBuf10 { uint col_data10[]; };
layout(std430, binding = 11) readonly buffer ColBuf11 { uint col_data11[]; };
layout(std430, binding = 12) readonly buffer ColBuf12 { uint col_data12[]; };
layout(std430, binding = 13) readonly buffer ColBuf13 { uint col_data13[]; };
layout(std430, binding = 14) readonly buffer ColBuf14 { uint col_data14[]; };
layout(std430, binding = 15) readonly buffer ColBuf15 { uint col_data15[]; };

layout(push_constant) uniform PushConstants
{
  uint words[16];
} pc;

shared uint s_match_count;
shared uint s_match_base;

uint
read_col_word(uint slot, uint word_index)
{
  switch (slot)
  {
    case 0u: return col_data6[word_index];
    case 1u: return col_data7[word_index];
    case 2u: return col_data8[word_index];
    case 3u: return col_data9[word_index];
    case 4u: return col_data10[word_index];
    case 5u: return col_data11[word_index];
    case 6u: return col_data12[word_index];
    case 7u: return col_data13[word_index];
    case 8u: return col_data14[word_index];
    case 9u: return col_data15[word_index];
  }
  return 0u;
}

uint
read_col_byte(uint slot, uint byte_index)
{
  uint word = read_col_word(slot, byte_index / 4u);
  uint shift = (byte_index % 4u) * 8u;
  return (word >> shift) & 0xffu;
}

uint
read_str_const_byte(uint word_offset, uint byte_index)
{
  uint word = str_consts[word_offset + byte_index / 4u];
  uint shift = (byte_index % 4u) * 8u;
  return (word >> shift) & 0xffu;
}

uint
read_str_offset(uint offsets_slot, uint row)
{
  return read_col_word(offsets_slot, row * 2u);
}

// tec: every column type the host lets through is one word per row, except bool, one byte per row
uint
read_num_column_bits(uint slot, uint coltype, uint row)
{
  if (coltype == COLTYPE_BOOL)
  {
    return read_col_byte(slot, row);
  }
  return read_col_word(slot, row);
}

bool
str_eq(uint slot, uint row, uint const_word_offset, uint const_len)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;
  if (len != const_len)
  {
    return false;
  }
  for (uint i = 0u; i < len; i++)
  {
    if (read_col_byte(slot, start + i) != read_str_const_byte(const_word_offset, i))
    {
      return false;
    }
  }
  return true;
}

// tec: this matches qe_str8_compare. 3 way compare
int
str_cmp3(uint slot, uint row, uint const_word_offset, uint const_len)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;
  uint min_len = min(len, const_len);
  for (uint i = 0u; i < min_len; i++)
  {
    uint a = read_col_byte(slot, start + i);
    uint b = read_str_const_byte(const_word_offset, i);
    if (a != b)
    {
      return (a < b) ? -1 : 1;
    }
  }
  if (len < const_len)
  {
    return -1;
  }
  if (len > const_len)
  {
    return 1;
  }
  return 0;
}

#define MAX_SANE_STRING_LEN 1048576u

bool
str_contains(uint slot, uint row, uint const_word_offset, uint const_len)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;
  if (const_len == 0u)
  {
    return true;
  }
  if (len > MAX_SANE_STRING_LEN || const_len > len)
  {
    return false;
  }
  for (uint window = 0u; window <= len - const_len; window++)
  {
    bool match = true;
    for (uint i = 0u; i < const_len; i++)
    {
      if (read_col_byte(slot, start + window + i) != read_str_const_byte(const_word_offset, i))
      {
        match = false;
        break;
      }
    }
    if (match)
    {
      return true;
    }
  }
  return false;
}

// tec: -1, 0 or 1 for a against b in the comparison's domain. a NaN compares unordered, so every comparison but != is false
bool
typed_compare(uint opcode, uint domain, uint a, uint b)
{
  bool lt;
  bool eq;
  bool unordered = false;
  if (domain == DOMAIN_I32)
  {
    lt = int(a) < int(b);
    eq = a == b;
  }
  else if (domain == DOMAIN_F32)
  {
    float fa = uintBitsToFloat(a);
    float fb = uintBitsToFloat(b);
    unordered = isnan(fa) || isnan(fb);
    lt = fa < fb;
    eq = fa == fb;
  }
  else
  {
    lt = a < b;
    eq = a == b;
  }
  if (unordered)
  {
    return opcode == OP_CMP_NE;
  }
  switch (opcode)
  {
    case OP_CMP_EQ: return eq;
    case OP_CMP_NE: return !eq;
    case OP_CMP_LT: return lt;
    case OP_CMP_GT: return !lt && !eq;
    case OP_CMP_LE: return lt || eq;
    case OP_CMP_GE: return !lt;
  }
  return false;
}

void
main()
{
  uint row_count = pc.words[0];
  uint row = gl_GlobalInvocationID.x;
  bool in_range = row < row_count;
  // tec: pc.words[6]/[8] are the lo words of push-constant slots 3 and 4, a skipped row is treated like a row past the end
  if (in_range && pc.words[8] != 0u)
  {
    uint skip_chunk = row >> pc.words[6];
    in_range = (skip_bits[skip_chunk >> 5u] & (1u << (skip_chunk & 31u))) == 0u;
  }
  if (gl_LocalInvocationIndex == 0u)
  {
    s_match_count = 0u;
  }

  uint stack[MAX_STACK];
  int sp = 0;
  uint ip = 0u;
  bool running = true;
  uint bytecode_word_count = bytecode.length();
  uint steps = 0u;

  while (in_range && running && ip < bytecode_word_count && steps < bytecode_word_count + 64u)
  {
    steps++;
    uint word = bytecode[ip++];
    uint opcode = word & 0xffu;
    uint domain = word >> DOMAIN_SHIFT;

    switch (opcode)
    {
      case OP_HALT:
      {
        running = false;
      } break;

      case OP_PUSH_TRUE:
      {
        stack[sp++] = 1u;
      } break;

      case OP_PUSH_FALSE:
      {
        stack[sp++] = 0u;
      } break;

      case OP_LOAD_NUM_COL:
      {
        uint operand = bytecode[ip++];
        uint slot = operand & 0xffu;
        uint coltype = (operand >> 8) & 0xffu;
        stack[sp++] = read_num_column_bits(slot, coltype, row);
      } break;

      case OP_PUSH_CONST:
      {
        uint const_index = bytecode[ip++];
        stack[sp++] = num_consts[const_index];
      } break;

      case OP_CMP_EQ:
      case OP_CMP_NE:
      case OP_CMP_LT:
      case OP_CMP_GT:
      case OP_CMP_LE:
      case OP_CMP_GE:
      {
        uint b = stack[--sp];
        uint a = stack[--sp];
        stack[sp++] = typed_compare(opcode, domain, a, b) ? 1u : 0u;
      } break;

      case OP_AND:
      {
        uint b = stack[--sp];
        uint a = stack[--sp];
        stack[sp++] = (a != 0u && b != 0u) ? 1u : 0u;
      } break;

      case OP_OR:
      {
        uint b = stack[--sp];
        uint a = stack[--sp];
        stack[sp++] = (a != 0u || b != 0u) ? 1u : 0u;
      } break;

      case OP_STR_EQ:
      case OP_STR_NE:
      case OP_STR_CONTAINS:
      case OP_STR_LT:
      case OP_STR_GT:
      case OP_STR_LE:
      case OP_STR_GE:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        bool hit = false;
        if (opcode == OP_STR_EQ)
        {
          hit = str_eq(slot, row, const_word_offset, const_len);
        }
        else if (opcode == OP_STR_NE)
        {
          hit = !str_eq(slot, row, const_word_offset, const_len);
        }
        else if (opcode == OP_STR_CONTAINS)
        {
          hit = str_contains(slot, row, const_word_offset, const_len);
        }
        else
        {
          int order = str_cmp3(slot, row, const_word_offset, const_len);
          hit = (opcode == OP_STR_LT && order < 0) || (opcode == OP_STR_GT && order > 0) ||
                (opcode == OP_STR_LE && order <= 0) || (opcode == OP_STR_GE && order >= 0);
        }
        stack[sp++] = hit ? 1u : 0u;
      } break;

      default:
      {
        running = false;
      } break;
    }
  }

  bool matched = in_range && (sp > 0) && (stack[sp - 1] != 0u);
  barrier();
  uint local_position = 0u;
  if (matched)
  {
    local_position = atomicAdd(s_match_count, 1u);
  }
  barrier();
  if (gl_LocalInvocationIndex == 0u)
  {
    s_match_base = (s_match_count > 0u) ? atomicAdd(out_count[0], s_match_count) : 0u;
  }
  barrier();
  if (matched)
  {
    uint pos = s_match_base + local_position;
    if (pos < out_indices.length() / 2u)
    {
      out_indices[pos * 2u + 0u] = row;
      out_indices[pos * 2u + 1u] = 0u;
    }
  }
}
