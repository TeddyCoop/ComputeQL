#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

// tec: generic, precompiled scan+filter operator.
// Interprets a small per-row bytecode program matching row to the output indices buffer.
//
// NOTE: binding layout/opcode values MUST stay in sync with query_exec.h

layout(local_size_x = 256) in;

#define OP_PUSH_TRUE     0
#define OP_LOAD_NUM_COL  1
#define OP_PUSH_CONST    2
#define OP_CMP_EQ        3
#define OP_CMP_NE        4
#define OP_CMP_LT        5
#define OP_CMP_GT        6
#define OP_CMP_LE        7
#define OP_CMP_GE        8
#define OP_AND           9
#define OP_OR            10
#define OP_STR_EQ        11
#define OP_STR_CONTAINS  12
#define OP_HALT          13
#define OP_PUSH_FALSE    14
#define OP_TRIGRAM_SIM   15
#define OP_EDIT_DISTANCE 16
#define OP_STR_NE        17
#define OP_STR_LT        18
#define OP_STR_GT        19
#define OP_STR_LE        20
#define OP_STR_GE        21

// tec: QE_TRIGRAM_MAX_NEEDLE_LEN/QE_EDIT_DISTANCE_MAX_NEEDLE_LEN settings can only lower this cap. cause this is done at compile time
#define QE_FUZZY_MAX_NEEDLE_LEN 64

#define COLTYPE_U32      1
#define COLTYPE_U64      2
#define COLTYPE_F32      3
#define COLTYPE_F64      4
#define COLTYPE_BOOL      6
#define COLTYPE_I32       7
#define COLTYPE_I64       8
#define COLTYPE_DATE      9
#define COLTYPE_TIMESTAMP 10
#define COLTYPE_DECIMAL   11
#define COLTYPE_ENUM      12

#define MAX_STACK 8

layout(std430, binding = 0) readonly buffer BytecodeBuf   { uint bytecode[]; };
layout(std430, binding = 1) readonly buffer NumConstsBuf  { uint num_consts[]; };
layout(std430, binding = 2) readonly buffer StrConstsBuf  { uint str_consts[]; };
layout(std430, binding = 3) buffer OutIndicesBuf          { uint out_indices[]; };
layout(std430, binding = 4) buffer OutCountBuf            { uint out_count[]; };

layout(std430, binding = 6)  readonly buffer ColBuf6  { uint col_data6[]; };
layout(std430, binding = 7)  readonly buffer ColBuf7  { uint col_data7[]; };
layout(std430, binding = 8)  readonly buffer ColBuf8  { uint col_data8[]; };
layout(std430, binding = 9)  readonly buffer ColBuf9  { uint col_data9[]; };
layout(std430, binding = 10) readonly buffer ColBuf10 { uint col_data10[]; };
layout(std430, binding = 11) readonly buffer ColBuf11 { uint col_data11[]; };
layout(std430, binding = 12) readonly buffer ColBuf12 { uint col_data12[]; };
layout(std430, binding = 13) readonly buffer ColBuf13 { uint col_data13[]; };
layout(std430, binding = 14) readonly buffer ColBuf14 { uint col_data14[]; };
layout(std430, binding = 15) readonly buffer ColBuf15 { uint col_data15[]; };

layout(push_constant) uniform PushConstants
{
  uint words[16];
} pc;

uint
read_col_word(uint slot, uint word_index)
{
  switch (slot)
  {
    case 0u: return col_data6[word_index];
    case 1u: return col_data7[word_index];
    case 2u: return col_data8[word_index];
    case 3u: return col_data9[word_index];
    case 4u: return col_data10[word_index];
    case 5u: return col_data11[word_index];
    case 6u: return col_data12[word_index];
    case 7u: return col_data13[word_index];
    case 8u: return col_data14[word_index];
    case 9u: return col_data15[word_index];
  }
  return 0u;
}

uint
read_col_byte(uint slot, uint byte_index)
{
  uint word = read_col_word(slot, byte_index / 4u);
  uint shift = (byte_index % 4u) * 8u;
  return (word >> shift) & 0xffu;
}

uint
read_str_const_byte(uint word_offset, uint byte_index)
{
  uint word = str_consts[word_offset + byte_index / 4u];
  uint shift = (byte_index % 4u) * 8u;
  return (word >> shift) & 0xffu;
}

// tec: string columns occupy two consecutive slots: `slot` is the raw byte data buffer,
// `slot + 1` is the (row_count + 1) U64 offsets array (2 words per offset, high word ignored, string blobs are assumed to stay under 4GB per chunk).
uint
read_str_offset(uint offsets_slot, uint row)
{
  return read_col_word(offsets_slot, row * 2u);
}

double
read_num_column_value(uint slot, uint coltype, uint row)
{
  if (coltype == COLTYPE_U32 || coltype == COLTYPE_ENUM)
  {
    return double(read_col_word(slot, row));
  }
  else if (coltype == COLTYPE_U64)
  {
    uint lo = read_col_word(slot, row * 2u + 0u);
    uint hi = read_col_word(slot, row * 2u + 1u);
    return double(hi) * 4294967296.0LF + double(lo);
  }
  else if (coltype == COLTYPE_F32)
  {
    return double(uintBitsToFloat(read_col_word(slot, row)));
  }
  else if (coltype == COLTYPE_F64)
  {
    uint lo = read_col_word(slot, row * 2u + 0u);
    uint hi = read_col_word(slot, row * 2u + 1u);
    return packDouble2x32(uvec2(lo, hi));
  }
  else if (coltype == COLTYPE_BOOL)
  {
    return double(read_col_byte(slot, row));
  }
  else if (coltype == COLTYPE_I32 || coltype == COLTYPE_DATE)
  {
    return double(int(read_col_word(slot, row)));
  }
  else // COLTYPE_I64, COLTYPE_TIMESTAMP, or COLTYPE_DECIMAL
  {
    uint lo = read_col_word(slot, row * 2u + 0u);
    uint hi = read_col_word(slot, row * 2u + 1u);
    double unsigned_value = double(hi) * 4294967296.0LF + double(lo);
    bool is_negative = (hi & 0x80000000u) != 0u;
    return is_negative ? unsigned_value - 18446744073709551616.0LF : unsigned_value;
  }
}

bool
str_eq(uint slot, uint row, uint const_word_offset, uint const_len)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;

  if (len != const_len) return false;

  for (uint i = 0u; i < len; i++)
  {
    if (read_col_byte(slot, start + i) != read_str_const_byte(const_word_offset, i))
    {
      return false;
    }
  }
  return true;
}

// tec: this matches qe_str8_compare. 3 way compare
int
str_cmp3(uint slot, uint row, uint const_word_offset, uint const_len)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;

  uint min_len = min(len, const_len);
  for (uint i = 0u; i < min_len; i++)
  {
    uint a = read_col_byte(slot, start + i);
    uint b = read_str_const_byte(const_word_offset, i);
    if (a != b) 
		{
			return (a < b) ? -1 : 1;
		}
  }
  if (len < const_len) return -1;
  if (len > const_len) return 1;
  return 0;
}

// tec: cap on string length considered by the byte scan loops below
#define MAX_SANE_STRING_LEN 1048576u

bool
str_contains(uint slot, uint row, uint const_word_offset, uint const_len)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;

  if (const_len == 0u) return true;
  if (len > MAX_SANE_STRING_LEN) return false;
  if (const_len > len) return false;

  for (uint window = 0u; window <= len - const_len; window++)
  {
    bool match = true;
    for (uint i = 0u; i < const_len; i++)
    {
      if (read_col_byte(slot, start + window + i) != read_str_const_byte(const_word_offset, i))
      {
        match = false;
        break;
      }
    }
    if (match) return true;
  }
  return false;
}

//~ tec: Jaccard-style trigram similarity in [0,1]. greedy needle gram matching
double
trigram_similarity(uint slot, uint row, uint const_word_offset, uint const_len, uint n)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;

  if (len < n || const_len < n)
  {
    if (len != const_len) return 0.0LF;
    for (uint i = 0u; i < len; i++)
    {
      if (read_col_byte(slot, start + i) != read_str_const_byte(const_word_offset, i))
			{
				return 0.0LF;
			}
    }
    return 1.0LF;
  }
  if (len > MAX_SANE_STRING_LEN) return 0.0LF;

  uint needle_grams = min(const_len - n + 1u, QE_FUZZY_MAX_NEEDLE_LEN);
  bool needle_used[QE_FUZZY_MAX_NEEDLE_LEN];
  for (uint j = 0u; j < needle_grams; j++) needle_used[j] = false;

  uint haystack_grams = len - n + 1u;
  uint shared_grams = 0u;
  for (uint i = 0u; i < haystack_grams; i++)
  {
    for (uint j = 0u; j < needle_grams; j++)
    {
      if (needle_used[j]) continue;
      bool match = true;
      for (uint k = 0u; k < n; k++)
      {
        if (read_col_byte(slot, start + i + k) != read_str_const_byte(const_word_offset, j + k))
        {
          match = false;
          break;
        }
      }
      if (match)
      {
        needle_used[j] = true;
        shared_grams++;
        break;
      }
    }
  }

  uint union_size = haystack_grams + needle_grams - shared_grams;
  return (union_size == 0u) ? 0.0LF : double(shared_grams) / double(union_size);
}

//~ tec: bounded rolling row Levenshtein distance 
double
edit_distance(uint slot, uint row, uint const_word_offset, uint const_len)
{
  uint start = read_str_offset(slot + 1u, row);
  uint end = read_str_offset(slot + 1u, row + 1u);
  uint len = end - start;

  if (len > MAX_SANE_STRING_LEN) return double(MAX_SANE_STRING_LEN);

  uint needle_len = min(const_len, QE_FUZZY_MAX_NEEDLE_LEN);
  uint dp[QE_FUZZY_MAX_NEEDLE_LEN + 1u];
  for (uint j = 0u; j <= needle_len; j++) dp[j] = j;

  for (uint i = 1u; i <= len; i++)
  {
    uint prev_diag = dp[0];
    dp[0] = i;
    uint haystack_byte = read_col_byte(slot, start + i - 1u);
    for (uint j = 1u; j <= needle_len; j++)
    {
      uint tmp = dp[j];
      uint needle_byte = read_str_const_byte(const_word_offset, j - 1u);
      uint cost = (haystack_byte == needle_byte) ? 0u : 1u;
      uint del = dp[j] + 1u;
      uint ins = dp[j - 1u] + 1u;
      uint sub = prev_diag + cost;
      dp[j] = min(min(del, ins), sub);
      prev_diag = tmp;
    }
  }

  return double(dp[needle_len]);
}

void
main()
{
  uint row_count = pc.words[0];
  uint row = gl_GlobalInvocationID.x;
  if (row >= row_count) return;

  // tec: pc.words[2]/[4] are the lo words of push-constant slots
	// score_flags bit0=has_aux_score, bit1=score_is_distance
  uint score_flags = pc.words[2];
  bool has_aux_score = (score_flags & 1u) != 0u;
  uint trigram_n = max(pc.words[4], 1u);
  uint aux_score_bits = 0u;

  double stack[MAX_STACK];
  int sp = 0;

  uint ip = 0u;
  bool running = true;

  // tec: defensive bound on both the instruction pointer and total steps taken
  uint bytecode_word_count = bytecode.length();
  uint steps = 0u;

  while (running && ip < bytecode_word_count && steps < bytecode_word_count + 64u)
  {
    steps++;
    uint opcode = bytecode[ip++];

    switch (opcode)
    {
      case OP_HALT:
      {
        running = false;
      } break;

      case OP_PUSH_TRUE:
      {
        stack[sp++] = 1.0LF;
      } break;

      case OP_PUSH_FALSE:
      {
        stack[sp++] = 0.0LF;
      } break;

      case OP_LOAD_NUM_COL:
      {
        uint operand = bytecode[ip++];
        uint slot = operand & 0xffu;
        uint coltype = (operand >> 8) & 0xffu;
        stack[sp++] = read_num_column_value(slot, coltype, row);
      } break;

      case OP_PUSH_CONST:
      {
        uint const_index = bytecode[ip++];
        uint lo = num_consts[const_index * 2u + 0u];
        uint hi = num_consts[const_index * 2u + 1u];
        stack[sp++] = packDouble2x32(uvec2(lo, hi));
      } break;

      case OP_CMP_EQ:
			{ 
				double b = stack[--sp]; 
				double a = stack[--sp]; 
				stack[sp++] = (a == b) ? 1.0LF : 0.0LF; 
			} break;

      case OP_CMP_NE: 
			{ 
				double b = stack[--sp]; 
				double a = stack[--sp]; 
				stack[sp++] = (a != b) ? 1.0LF : 0.0LF; 
			} break;

      case OP_CMP_LT: 
			{ 
				double b = stack[--sp]; 
				double a = stack[--sp]; 
				stack[sp++] = (a <  b) ? 1.0LF : 0.0LF; 
			} break;

      case OP_CMP_GT:
			{ 
				double b = stack[--sp]; 
				double a = stack[--sp]; 
				stack[sp++] = (a >  b) ? 1.0LF : 0.0LF; 
			} break;

      case OP_CMP_LE: 
			{ 
				double b = stack[--sp];
				double a = stack[--sp]; 
				stack[sp++] = (a <= b) ? 1.0LF : 0.0LF; 
			} break;

      case OP_CMP_GE:
		  {
				double b = stack[--sp]; 
				double a = stack[--sp]; 
				stack[sp++] = (a >= b) ? 1.0LF : 0.0LF;
			} break;

      case OP_AND: 
			{ 
				double b = stack[--sp]; 
				double a = stack[--sp]; 
				stack[sp++] = (a != 0.0LF && b != 0.0LF) ? 1.0LF : 0.0LF; 
			} break;

      case OP_OR:  
			{ 
				double b = stack[--sp]; 
				double a = stack[--sp]; 
				stack[sp++] = (a != 0.0LF || b != 0.0LF) ? 1.0LF : 0.0LF; 
			} break;

      case OP_STR_EQ:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        stack[sp++] = str_eq(slot, row, const_word_offset, const_len) ? 1.0LF : 0.0LF;
      } break;

      case OP_STR_CONTAINS:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        stack[sp++] = str_contains(slot, row, const_word_offset, const_len) ? 1.0LF : 0.0LF;
      } break;

      case OP_STR_NE:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        stack[sp++] = str_eq(slot, row, const_word_offset, const_len) ? 0.0LF : 1.0LF;
      } break;

      case OP_STR_LT:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        stack[sp++] = (str_cmp3(slot, row, const_word_offset, const_len) < 0) ? 1.0LF : 0.0LF;
      } break;

      case OP_STR_GT:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        stack[sp++] = (str_cmp3(slot, row, const_word_offset, const_len) > 0) ? 1.0LF : 0.0LF;
      } break;

      case OP_STR_LE:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        stack[sp++] = (str_cmp3(slot, row, const_word_offset, const_len) <= 0) ? 1.0LF : 0.0LF;
      } break;

      case OP_STR_GE:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        stack[sp++] = (str_cmp3(slot, row, const_word_offset, const_len) >= 0) ? 1.0LF : 0.0LF;
      } break;

      case OP_TRIGRAM_SIM:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        double score = trigram_similarity(slot, row, const_word_offset, const_len, trigram_n);
        aux_score_bits = floatBitsToUint(float(score));
        stack[sp++] = score;
      } break;

      case OP_EDIT_DISTANCE:
      {
        uint slot = bytecode[ip++];
        uint const_word_offset = bytecode[ip++];
        uint const_len = bytecode[ip++];
        double score = edit_distance(slot, row, const_word_offset, const_len);
        aux_score_bits = uint(score);
        stack[sp++] = score;
      } break;

      default:
      {
        running = false;
      } break;
    }
  }

  bool matched = (sp > 0) && (stack[sp - 1] != 0.0LF);
  if (matched)
  {
    uint pos = atomicAdd(out_count[0], 1u);
    if (pos < out_indices.length() / 2u)
    {
      out_indices[pos * 2u + 0u] = row;
      out_indices[pos * 2u + 1u] = has_aux_score ? aux_score_bits : 0u;
    }
  }
}
